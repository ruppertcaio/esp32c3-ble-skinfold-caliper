# ESP32-C3 + BLE NimBLE
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# Fonte única do MTU (BleAdipometer.cpp usa este valor). Respostas JSON de até
# ~128 bytes precisam de ATT MTU > 131 (3 bytes de cabeçalho do notify).
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=185

# Libera memória do Bluetooth clássico. O ESP32-C3 já é BLE-only, mas deixa explícito.
CONFIG_BT_CLASSIC_ENABLED=n

# Logs úteis durante desenvolvimento
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
